# =============================================================================
# configs/rax3000me-accel.config
# Target: CMCC RAX3000Me (mt7981b-cmcc-rax3000me)
# Features: Hardware Acceleration, MTK WiFi Driver, TurboACC, FullConeNAT
# Kernel: Linux 6.6.95 | ImmortalWrt 24.10
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Target System & Profile
# -----------------------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me=y
CONFIG_TARGET_PROFILE="DEVICE_cmcc_rax3000me"
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=256

# -----------------------------------------------------------------------------
# 2. Kernel Configuration
# -----------------------------------------------------------------------------
CONFIG_KERNEL_6_6=y
CONFIG_LINUX_6_6=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_PROC_PAGE_MONITOR=y

# -----------------------------------------------------------------------------
# 3. MediaTek Wireless Driver (Official, NOT open-source)
# -----------------------------------------------------------------------------
CONFIG_MTK_WIFI_DRIVER=y
CONFIG_MTK_WIFI_7981=y
CONFIG_MTK_WIFI_BAND_STEERING=y
CONFIG_MTK_WIFI_MU_MIMO=y
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WIFI_160MHZ_SUPPORT=y
CONFIG_MTK_WIFI_DBDC_SUPPORT=y

CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_mt7981-2g-firmware=y
CONFIG_PACKAGE_mt7981-5g-firmware=y

# -----------------------------------------------------------------------------
# 4. Hardware Acceleration Core (CRITICAL)
# -----------------------------------------------------------------------------
# MediaTek Hardware NAT (HNAT) - Layer 3/4 offload
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_MTK_FAST_NAT_SUPPORT=y
CONFIG_MTK_PPE_OFFLOAD=y
CONFIG_MTK_PPE_V2=y

# WARP (Wireless Acceleration Runtime Platform) - WiFi offload
CONFIG_PACKAGE_kmod-warp=y
CONFIG_MTK_WARP_SUPPORT=y
CONFIG_MTK_WARP_V2=y

# Flow Offloading (Software fallback + HW assist)
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_HW=y
CONFIG_PACKAGE_kmod-ipt-offload=y

# -----------------------------------------------------------------------------
# 5. TurboACC LuCI Interface (Management UI)
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-en=y

# -----------------------------------------------------------------------------
# 6. FullCone NAT (P2P / Gaming / Remote Access)
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y
CONFIG_PACKAGE_nftables-mod-fullconenat=y

# -----------------------------------------------------------------------------
# 7. Wireless Management Tools (MTK Official)
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_mtwifi-cfg-scripts=y

# -----------------------------------------------------------------------------
# 8. Network Enhancement Modules
# -----------------------------------------------------------------------------
# Link Aggregation (Optional, for multi-WAN)
CONFIG_PACKAGE_kmod-bonding=y

# Netlink Diagnostic Tools
CONFIG_PACKAGE_kmod-netlink-diag=y

# Raw Socket Support (for advanced tools)
CONFIG_PACKAGE_kmod-ipt-raw=y

# QoS / Traffic Shaping
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_tc-mod-ipt=y

# -----------------------------------------------------------------------------
# 9. Base System & LuCI
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_kmod-crypto-acompress=y

# LuCI Core
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Recommended Theme
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# Language Packs
CONFIG_PACKAGE_luci-lang-zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# -----------------------------------------------------------------------------
# 10. Firewall & Network Services
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-fullcone=y

CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y

CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# -----------------------------------------------------------------------------
# 11. USB Support (RAX3000Me 部分版本无 USB，按需启用)
# -----------------------------------------------------------------------------
# 如有 USB 接口，取消以下注释：
# CONFIG_PACKAGE_kmod-usb-core=y
# CONFIG_PACKAGE_kmod-usb3=y
# CONFIG_PACKAGE_kmod-usb-storage=y
# CONFIG_PACKAGE_kmod-usb-net=y
# CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
# CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-f2fs=y
# CONFIG_PACKAGE_block-mount=y

# -----------------------------------------------------------------------------
# 12. Filesystem & Rootfs
# -----------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_KERNEL_GZIP=y

# eMMC/NAND 支持
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-mmc=y
CONFIG_PACKAGE_kmod-mtd-rw=y

# -----------------------------------------------------------------------------
# 13. Diagnostic & Utility Tools
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# -----------------------------------------------------------------------------
# 14. Optional Plugins (按需启用，默认注释)
# -----------------------------------------------------------------------------
# PassWall / 科学上网
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-passwall2=y

# SmartDNS / AdGuard
# CONFIG_PACKAGE_luci-app-smartdns=y
# CONFIG_PACKAGE_smartdns=y
# CONFIG_PACKAGE_luci-app-adguardhome=y

# Disk Management
# CONFIG_PACKAGE_luci-app-diskman=y
# CONFIG_PACKAGE_lsblk=y
# CONFIG_PACKAGE_fdisk=y

# Wake on LAN
# CONFIG_PACKAGE_luci-app-wol=y

# UPnP / NAT-PMP
# CONFIG_PACKAGE_miniupnpd=y
# CONFIG_PACKAGE_luci-app-upnp=y

# -----------------------------------------------------------------------------
# 15. Build System Settings
# -----------------------------------------------------------------------------
CONFIG_CCACHE=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_IB_STANDALONE=y

# Disable verbose for cleaner logs (set V=s in make command for debug)
# CONFIG_BUILD_LOG=y

# -----------------------------------------------------------------------------
# 16. Device Tree & Preloader Notes (DO NOT MODIFY HERE)
# -----------------------------------------------------------------------------
# RAX3000Me uses FIT image (.itb) format
# Preloader (bl2) selection is automatic based on:
#   - CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me=y
#   - Device tree: mt7981b-cmcc-rax3000me.dts
# DDR3/DDR4 preloader is selected at build time by mt7981-bl2 package
# Ensure your config matches your hardware:
#   DDR3: Use firmware with "-ddr3-" in filename
#   DDR4: Use firmware with "-ddr4-" in filename
# =============================================================================